# Copy to .env and adjust. Never commit .env.

# PostgreSQL (local install; create user/db to match or change the URL)
DATABASE_URL=postgresql://tripwise:tripwise@127.0.0.1:5432/tripwise_p1
# Optional: hosted Postgres (Supabase). Same schema + pgvector; does not change UI or API keys.
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# In Supabase SQL editor first:  CREATE EXTENSION IF NOT EXISTS vector;

# Wikimedia requires a descriptive User-Agent with contact information.
# https://foundation.wikimedia.org/wiki/Policy:Wikimedia_Foundation_User-Agent_Policy
WIKIVOYAGE_API_URL=https://en.wikivoyage.org/w/api.php
WIKIVOYAGE_USER_AGENT=TripWiseAI/0.1 (https://github.com/sumansurvi/tripWiseAI; travel-research portfolio project)

# Geographic / crawl scope (v1 product focus = India)
# Acquisition = Wikivoyage Action API (httpx). Not Playwright / HTML scrape.
# To add another country later: change TRIPWISE_SCOPE_ROOT + TRIPWISE_SEEDS and re-ingest.
# seeds_only | seeds_and_districts  (scope_root country BFS is Phase 2)
TRIPWISE_SCOPE_MODE=seeds_and_districts
TRIPWISE_SCOPE_ROOT=India
TRIPWISE_SEEDS=India,Delhi,Mumbai,Jaipur,Agra,Varanasi,Goa,Delhi/Old Delhi,Delhi/South,Mumbai/South,Mumbai/Fort
TRIPWISE_MAX_DEPTH=1
TRIPWISE_FOLLOW_GO_NEXT=false
TRIPWISE_ALLOWED_PAGE_TYPES=country,region,city,district,park,unknown

# HTTP
TRIPWISE_REQUEST_DELAY_SECONDS=1.0
TRIPWISE_MAX_RETRIES=4
TRIPWISE_TIMEOUT_SECONDS=45
TRIPWISE_BATCH_SIZE=5

# Logging
LOG_LEVEL=WARNING
LOG_JSON=true

# --- Phase 3 embeddings (local bge → pgvector; Gemini optional) ---
# Default is a local 768-d model so chat is not coupled to Gemini free-tier quota.
# Vectors still live in Postgres/Supabase (DATABASE_URL). Switching provider/model
# changes content_hash and forces a full re-embed — do not mix models in one table.
TRIPWISE_EMBEDDING_PROVIDER=local
# TRIPWISE_LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Optional Gemini fallback (same Vector(768) column; requires GEMINI_API_KEY):
# TRIPWISE_EMBEDDING_PROVIDER=gemini
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match Vector(768) in tripwise_p3.models
# GEMINI_EMBEDDING_DIM=768
# TRIPWISE_CHUNKS_DIR=data/chunks
# TRIPWISE_MIN_CHUNK_CHARS=40
# Texts per embed call (Gemini request batch, or local ONNX batch)
# TRIPWISE_EMBED_BATCH_SIZE=32
# Seconds between Gemini embed API requests (ignored for local)
# TRIPWISE_EMBED_MIN_INTERVAL_SEC=0.35

# --- Phase 5 chat LLM (Groq only; not required for Phase 3 embed) ---
# Get a key: https://console.groq.com/keys
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Best-cosine relevance gate; below this the API answers "I don't know" (no Groq call).
# Recalibrate after switching embedding models: python …/run_phase3.py calibrate-gate
# Calibrated on BAAI/bge-base-en-v1.5 (in-corpus min ≈ 0.67, out-of-corpus max ≈ 0.62)
# TRIPWISE_CHAT_MIN_SCORE=0.64
# On Vercel (Gemini), expect ~0.65 after calibrate-gate.

# Extra browser origins for CORS (comma-separated). Localhost always allowed.
# TRIPWISE_CORS_ORIGINS=https://your-app.vercel.app

# Production UI on Vercel: leave unset for same-origin /chat
# NEXT_PUBLIC_TRIPWISE_API_URL=

# --- Phase 2 scale India (used by run_phase2.py defaults; override here if desired) ---
# TRIPWISE_SCOPE_MODE=scope_root
# TRIPWISE_SCOPE_ROOT=India
# TRIPWISE_SEEDS=India
# TRIPWISE_MAX_DEPTH=12
# TRIPWISE_SKIP_PAGE_TYPES=itinerary,phrasebook
# TRIPWISE_MAX_PAGES=0
